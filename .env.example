# ============================================================
#  QA-SRM 环境配置模板
#  使用：cp .env.example .env  然后填入实际值
#  注意：.env 文件本身已在 .gitignore 中，不会入仓
# ============================================================

# ---------- 基础 ----------
APP_VERSION=2.0.0
APP_TIMEZONE=Asia/Shanghai

# ---------- 数据库 ----------
# 驱动：sqlite (开发/小规模) 或 mysql (生产)
DB_DRIVER=mysql
DB_PATH=./database/srm.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qa_srm
DB_USERNAME=qa_srm_user
DB_PASSWORD=change_me_in_production
DB_CHARSET=utf8mb4

# ---------- 上传 ----------
UPLOAD_PATH=./uploads

# ---------- Poppler (PDF 文本提取) ----------
# Windows 路径示例
POPPLER_PDFTEXT=./poppler/poppler-26.02.0/Library/bin/pdftotext.exe
POPPLER_PDFPPM=./poppler/poppler-26.02.0/Library/bin/pdftoppm.exe
# Linux 路径 (apt install poppler-utils)
# POPPLER_PDFTEXT=/usr/bin/pdftotext
# # POPPLER_PDFPPM=/usr/bin/pdftoppm

# ---------- Tesseract OCR (扫描件 PDF 本地识别) ----------
# Windows: 下载 https://github.com/UB-Mannheim/tesseract/wiki
# Linux: sudo apt install tesseract-ocr tesseract-ocr-chi-sim tesseract-ocr-eng
TESSERACT_PATH=./tesseract/tesseract.exe
# Linux: TESSERACT_PATH=/usr/bin/tesseract

