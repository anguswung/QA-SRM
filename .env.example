# ============================================================
#  QA-SRM 环境配置模板
#  使用：cp .env.example .env  然后填入实际值
#  注意：.env 文件本身已在 .gitignore 中，不会入仓
# ============================================================

# ---------- 基础 ----------
APP_VERSION=2.0.0
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai

# ---------- 数据库 ----------
# 驱动：sqlite (开发/小规模) 或 mysql (生产)
DB_DRIVER=mysql
DB_PATH=./database/srm.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qa_srm
DB_USERNAME=qa_srm_user
DB_PASSWORD=change_me_in_production
DB_CHARSET=utf8mb4

# ---------- Redis 缓存 / 会话 / 队列 ----------
# 未配置时系统自动降级到无缓存模式（功能不受影响，性能略降）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT 鉴权 ----------
# 生产环境务必用强随机字符串：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_RANDOM_48_BYTES_BASE64
JWT_ACCESS_EXPIRE=7200
JWT_REFRESH_EXPIRE=604800

# ---------- 上传 ----------
UPLOAD_PATH=./uploads
UPLOAD_MAX_SIZE=20971520
UPLOAD_ALLOWED=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,zip

# ---------- Poppler (PDF 文本提取) ----------
# Windows 路径示例
POPPLER_PDFTEXT=./poppler/poppler-26.02.0/Library/bin/pdftotext.exe
POPPLER_PDFINFO=./poppler/poppler-26.02.0/Library/bin/pdfinfo.exe
# Linux/Docker 路径
# POPPLER_PDFTEXT=/usr/bin/pdftotext
# POPPLER_PDFINFO=/usr/bin/pdfinfo

# ---------- OCR (扫描件 PDF 降级方案) ----------
# 注册 https://ocr.space 免费账号获取，免费版 500 次/天
OCR_API_KEY=your_ocr_space_api_key_here
OCR_API_URL=https://api.ocr.space/parse/image

# ---------- SMTP 邮件通知 ----------
# 配置后审核驳回/公告发布等事件会同步发邮件
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=change_me
SMTP_FROM=noreply@example.com
SMTP_ENCRYPTION=tls

# ---------- 速率限制 ----------
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=60

# ---------- 预警阈值（天） ----------
WARNING_YELLOW=30
WARNING_ORANGE=15
WARNING_RED=7
